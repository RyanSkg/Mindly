# Copie este arquivo para ".env" e preencha com as suas chaves.
# Nenhuma chave real é versionada no repositório.

# Chave gratuita da Groq (IA de análise, chat e transcrição) — https://console.groq.com
GROQ_API_KEY=

# Service role key do projeto Supabase (Configurações do projeto → API).
# Usada só no servidor (exclusão de conta e jobs de email). NUNCA exponha no navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Chave do Resend (emails de lembrete/relatório) — https://resend.com (opcional em dev)
RESEND_API_KEY=

# Protege os endpoints de cron contra chamadas externas (qualquer texto secreto; opcional em dev)
CRON_SECRET=

# URL pública do app, usada nos links dos emails (opcional em dev)
APP_URL=http://localhost:4200
